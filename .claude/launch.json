{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "careeros-backend",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--host", "0.0.0.0", "--port", "8010"],
      "port": 8010,
      "autoPort": false,
      "cwd": "backend"
    },
    {
      "name": "careeros-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "3003"],
      "port": 3003,
      "autoPort": false,
      "cwd": "frontend",
      "env": {
        "NEXT_PUBLIC_API_URL": "http://localhost:8001",
        "NEXT_PUBLIC_API_KEY": ""
      }
    },
    {
      "name": "careeros-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "3000"],
      "port": 3000,
      "autoPort": false,
      "cwd": "frontend"
    }
  ]
}
