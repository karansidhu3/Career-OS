DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/careeros

# Restricted, non-superuser role for request handling — required for Row-Level
# Security to actually be enforced. See migrations/006_enable_row_level_security.sql
# and the role-setup instructions in that migration's accompanying docs.
# Falls back to DATABASE_URL when unset (RLS is then a no-op, not an error).
APP_DATABASE_URL=postgresql+asyncpg://careeros_app:password@localhost:5432/careeros

# Envelope-encryption key for per-user AI provider credentials (Phase 3, BYO key).
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store as a Railway secret in production — never commit a real value.
ENCRYPTION_MASTER_KEY=

# Set true only for local dev to bypass the Clerk-not-configured startup check. Never in production.
DEV_MODE=false

# Clerk dashboard → API Keys (same app as the frontend's NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY)
CLERK_SECRET_KEY=sk_test_...
# Frontend API domain decoded from the publishable key, used to build the JWKS verification URL
CLERK_FRONTEND_API_DOMAIN=your-app-name.clerk.accounts.dev

# In production, set to your Railway frontend URL (comma-separate multiple origins)
ALLOWED_ORIGINS=http://localhost:3000

# ARQ job queue backend (Phase 5). Run the worker separately: `arq app.worker.WorkerSettings`
REDIS_URL=redis://localhost:6379

# Local-filesystem PDF cache (Phase 5) — used automatically whenever R2_BUCKET_NAME below is
# unset. Not meant for production use as-is: not shared across replicas, doesn't survive a
# container restart. See app.services.pdf_storage.
PDF_STORAGE_DIR=./pdf_storage

# Cloudflare R2 (S3-compatible) — the production PDF storage backend. Leave all four unset to
# keep using the local-filesystem fallback above. Setup: Cloudflare dashboard → R2 Object
# Storage → create a bucket → "Manage R2 API Tokens" → create a token scoped to that bucket with
# Object Read & Write. Account ID is shown in the R2 overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Resend (Phase 6) — transactional email ONLY, scoped to two triggers: data export ready,
# account deletion confirmation. See CLAUDE.md's "What NOT to build" carve-out — nothing
# beyond those two triggers. Leave RESEND_API_KEY unset locally; get_email_client() falls
# back to a no-op that logs instead of sending, so local dev never needs a real key.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=CareerOS <onboarding@resend.dev>

# Sentry (Phase 7) — exception tracking. Leave unset locally; init_error_tracking()
# is a no-op without a DSN, so local dev never talks to Sentry. Get a DSN from
# Sentry dashboard → Settings → Projects → (your project) → Client Keys (DSN).
SENTRY_DSN=

# Per-user daily generation cap (Phase 7) — rolling 24h window, counted in Redis.
DAILY_GENERATION_LIMIT=20

# Anomaly detection (Phase 7) — generations within a 10-minute window before a
# structured warning is logged (not blocked — DAILY_GENERATION_LIMIT is the hard cap).
VELOCITY_ANOMALY_THRESHOLD=5
