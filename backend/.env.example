DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/careeros

# Restricted, non-superuser role for request handling — required for Row-Level
# Security to actually be enforced. See migrations/006_enable_row_level_security.sql
# and the role-setup instructions in that migration's accompanying docs.
# Falls back to DATABASE_URL when unset (RLS is then a no-op, not an error).
APP_DATABASE_URL=postgresql+asyncpg://careeros_app:password@localhost:5432/careeros

ANTHROPIC_API_KEY=sk-ant-...

# Set true only for local dev to bypass the Clerk-not-configured startup check. Never in production.
DEV_MODE=false

# Clerk dashboard → API Keys (same app as the frontend's NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY)
CLERK_SECRET_KEY=sk_test_...
# Frontend API domain decoded from the publishable key, used to build the JWKS verification URL
CLERK_FRONTEND_API_DOMAIN=your-app-name.clerk.accounts.dev

# In production, set to your Railway frontend URL (comma-separate multiple origins)
ALLOWED_ORIGINS=http://localhost:3000
